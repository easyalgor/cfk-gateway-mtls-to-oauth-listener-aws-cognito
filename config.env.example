# =============================================================================
# Copy this file to `config.env` and fill in every value:
#   cp config.env.example config.env
#
# `config.env` is git-ignored because it holds client secrets.
# docs/aws-cognito-setup.md shows where to find each Cognito value.
# =============================================================================

# ---- Kubernetes --------------------------------------------------------------
# StorageClass for broker / controller / Control Center volumes.
# EKS: gp2 or gp3   GKE: standard-rwo   AKS: managed-csi   kind/minikube: standard
STORAGE_CLASS=gp2

# ---- AWS Cognito user pool ---------------------------------------------------
# Region and user pool ID, e.g. us-east-2 and us-east-2_AbCdEf123.
COGNITO_REGION=<region>
COGNITO_USER_POOL_ID=<user-pool-id>
# Cognito domain (App integration -> Domain), host name only, no https://
# e.g. my-prefix.auth.us-east-2.amazoncognito.com or auth.mycompany.com
COGNITO_DOMAIN=<prefix>.auth.<region>.amazoncognito.com
# Custom scope of your resource server, requested by the CFK operator.
COGNITO_SCOPE=cp-resource/cp-resource-access

# ---- App client 1: Confluent service client (client_credentials) ------------
# Used by the brokers, MDS and the CFK operator. Its client ID becomes a Kafka
# super user and gets SystemAdmin via manifests/rbac/operator-rolebinding.yaml.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ---- App client 2: Control Center SSO client (authorization code) -----------
# Used for "Log in via SSO" in Control Center. Cognito does not allow one app
# client to use both client_credentials and authorization code, so this is a
# separate client.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# `sub` of the Cognito user who should be SystemAdmin in Control Center.
# (User pool -> Users -> <user> -> "User ID (Sub)". Not the email address.)
SSO_ADMIN_SUB=

# ---- App client 3: Gateway swap client (client_credentials) -----------------
# The gateway exchanges the client certificate for a token of THIS client, so
# Kafka sees every request from that certificate as User:<this client ID>.
# For a quick test you can reuse OAUTH_CLIENT_ID (a super user); for anything
# real, use a dedicated client with least privilege.
GATEWAY_SWAP_CLIENT_ID=
GATEWAY_SWAP_CLIENT_SECRET=

# ---- Gateway -----------------------------------------------------------------
# Host name clients use to reach the gateway. Goes into the gateway certificate.
GATEWAY_DOMAIN=gateway.example.com
# CN of the demo client certificate. The gateway swaps this identity for the
# Cognito client above.
GATEWAY_CLIENT_CN=alice

# ---- External DNS domain (optional) -----------------------------------------
# Used for the brokers' direct OAuth+mTLS listener (LoadBalancer) and, if you
# enable it, the Control Center LoadBalancer. Goes into the certificate SANs.
#   brokers:        b0.<domain>, b1.<domain>, b2.<domain>   bootstrap: kafka.<domain>
#   Control Center: controlcenter.<domain>
EXTERNAL_DOMAIN=mydomain.example

# ---- Local client keystores --------------------------------------------------
# Password for the JKS files generated for the demo client.
CLIENT_STORE_PASSWORD=changeit
